# Copia este archivo a ".env" y pega tu key de Riot
# Para un despliegue publico usa una Production API Key aprobada por Riot.
RIOT_API_KEY=RGAPI-REEMPLAZAR_CON_TU_KEY
RIOT_KEY_TYPE=development
PUBLIC_DEPLOYMENT=false

# Orígenes permitidos para el backend local, separados por comas. Déjalo vacío
# para aceptar únicamente solicitudes same-origin.
# CORS_ORIGIN=http://localhost:3000

# Puerto donde corre el servidor local (opcional)
PORT=3000

# Preparacion para persistencia online (configurar solo en el backend)
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
